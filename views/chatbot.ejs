<!-- Chatbot Widget (included in boilerplate) -->
<div id="chat-container" class="hidden">
  <div id="chat-header">
    <div class="chat-title">
      <span class="status-dot"></span>
      Findify Assistant
    </div>
    <div class="chat-header-actions">
      <button id="theme-toggle-btn" title="Toggle theme"><i class="fa fa-adjust"></i></button>
      <button id="export-chat-btn" title="Export chat"><i class="fa fa-download"></i></button>
      <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role && currentUser.role.toLowerCase() === 'admin') { %>
        <a href="/chatbot/analytics" target="_blank" id="analytics-link" title="Analytics"><i class="fa fa-chart-bar"></i></a>
      <% } %>
      <button id="close-chat" title="Close"><i class="fa fa-times"></i></button>
    </div>
  </div>

  <div id="chat-box"></div>

  <div id="typing-indicator">
    <div class="typing-dots">
      <span></span><span></span><span></span>
    </div>
  </div>

  <div id="voice-status"></div>

  <form id="chat-form">
    <input type="text" id="user-input" placeholder="Ask me anything..." autocomplete="off">
    <button type="button" id="voice-btn" title="Voice input"><i class="fa fa-microphone"></i></button>
    <button type="submit" title="Send"><i class="fa fa-paper-plane"></i></button>
  </form>
</div>

<button id="chat-launcher" title="Open chat">
  <i class="fa fa-comments"></i>
</button>