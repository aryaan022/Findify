<%= layout("layouts/boilerplate") %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <h1>Reset Password</h1>
      <p>Enter the OTP sent to your email and set a new password</p>
    </div>

    <% if (errors && errors.length > 0) { %>
      <div class="error-list">
        <% errors.forEach(error => { %>
          <p><i class="fa fa-exclamation-circle me-1"></i><%= error.msg %></p>
        <% }) %>
      </div>
    <% } %>

    <form action="/reset-password" method="POST" class="auth-form" id="resetForm">
      <input type="hidden" name="email" value="<%= email %>">
      <div class="form-group">
        <label for="otp" class="form-label">Verification Code</label>
        <input type="text" name="otp" id="otp" class="form-control" placeholder="Enter 6-digit code" maxlength="6" style="text-align:center;letter-spacing:0.3em;font-size:1.2rem;" required>
      </div>
      <div class="form-group">
        <label for="password" class="form-label">New Password</label>
        <input type="password" name="password" id="password" class="form-control" placeholder="Min 8 characters" required minlength="8">
        <div class="password-strength" style="margin-top:8px;">
          <div class="strength-bar"><div class="strength-fill" id="strengthFill" style="width:0;"></div></div>
          <span class="strength-text" id="strengthText"></span>
        </div>
      </div>
      <div class="form-group">
        <label for="confirmPassword" class="form-label">Confirm Password</label>
        <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" placeholder="Confirm your password" required>
      </div>
      <button type="submit" class="auth-btn">Reset Password</button>
    </form>

    <div style="text-align:center;margin-top:20px;">
      <form action="/resend-reset-otp" method="POST" style="display:inline;">
        <input type="hidden" name="email" value="<%= email %>">
        <p style="color:var(--text-muted);font-size:0.85rem;">
          Didn't receive a code? <button type="submit" id="resendBtn" style="background:none;border:none;color:var(--accent);cursor:pointer;font-family:var(--font-family);font-size:0.85rem;" disabled>Resend (<span id="countdown">60</span>s)</button>
        </p>
      </form>
    </div>

    <div class="auth-footer">
      <a href="/login">Back to Sign In</a>
    </div>
  </div>
</div>

<script>
  // Countdown timer
  let timeLeft = 60;
  const countdownEl = document.getElementById('countdown');
  const resendBtn = document.getElementById('resendBtn');
  const timer = setInterval(() => {
    timeLeft--;
    countdownEl.textContent = timeLeft;
    if (timeLeft <= 0) {
      clearInterval(timer);
      resendBtn.disabled = false;
      resendBtn.innerHTML = 'Resend Code';
    }
  }, 1000);

  // Password strength
  document.getElementById('password').addEventListener('input', function() {
    const val = this.value;
    const fill = document.getElementById('strengthFill');
    const text = document.getElementById('strengthText');
    let strength = 0;
    if (val.length >= 8) strength += 25;
    if (/[A-Z]/.test(val)) strength += 25;
    if (/[0-9]/.test(val)) strength += 25;
    if (/[^A-Za-z0-9]/.test(val)) strength += 25;
    fill.style.width = strength + '%';
    fill.style.background = strength < 50 ? 'var(--error)' : strength < 75 ? 'var(--warning)' : 'var(--success)';
    text.textContent = strength < 50 ? 'Weak' : strength < 75 ? 'Good' : 'Strong';
    text.style.color = fill.style.background;
  });

  // Form validation
  document.getElementById('resetForm').addEventListener('submit', function(e) {
    const otp = document.getElementById('otp').value;
    const pw = document.getElementById('password').value;
    const cpw = document.getElementById('confirmPassword').value;
    if (!/^\d{6}$/.test(otp)) { e.preventDefault(); alert('Please enter a valid 6-digit code.'); return; }
    if (pw.length < 8) { e.preventDefault(); alert('Password must be at least 8 characters.'); return; }
    if (pw !== cpw) { e.preventDefault(); alert('Passwords do not match.'); return; }
  });
</script>
