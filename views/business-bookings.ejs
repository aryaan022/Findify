<%- layout('/layouts/boilerplate') %>

<div class="bookings-page main-content">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3" style="margin-bottom:24px;">
      <div>
        <h1 style="font-size:1.5rem;margin:0;"><%= business.Name %> — Bookings</h1>
        <p style="color:var(--text-muted);font-size:0.85rem;margin:4px 0 0;"><%= totalBookings || 0 %> total bookings</p>
      </div>
      <a href="/business/dashboard/<%= business._id %>" class="btn btn-ghost btn-sm"><i class="fa fa-arrow-left me-2"></i>Back to Dashboard</a>
    </div>

    <!-- Filter Tabs -->
    <div class="tab-nav" style="margin-bottom:24px;">
      <a href="/business/bookings/<%= business._id %>" class="tab-item active">All</a>
      <a href="/business/bookings/<%= business._id %>?status=pending" class="tab-item">Pending</a>
      <a href="/business/bookings/<%= business._id %>?status=confirmed" class="tab-item">Confirmed</a>
      <a href="/business/bookings/<%= business._id %>?status=completed" class="tab-item">Completed</a>
      <a href="/business/bookings/<%= business._id %>?status=cancelled" class="tab-item">Cancelled</a>
    </div>

    <% if (bookings && bookings.length > 0) { %>
      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr><th>Customer</th><th>Service</th><th>Date</th><th>Time</th><th>Status</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% bookings.forEach(booking => { %>
              <tr>
                <td style="font-weight:500;"><%= booking.customerName %></td>
                <td><%= booking.serviceName %></td>
                <td><%= new Date(booking.bookingDate).toLocaleDateString() %></td>
                <td><%= booking.bookingTime %></td>
                <td>
                  <span class="booking-status <%= booking.status %>"><%= booking.status %></span>
                </td>
                <td>
                  <button class="action-btn primary" onclick="editBooking('<%= booking._id %>', '<%= booking.status %>')"><i class="fa fa-edit"></i></button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-icon"><i class="fa fa-calendar"></i></div>
        <h3>No bookings found</h3>
        <p>Bookings will appear here when customers book your services</p>
      </div>
    <% } %>
  </div>
</div>

<!-- Edit Booking Modal -->
<div class="modal fade" id="editBookingModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Update Booking Status</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="form-group" style="margin-bottom:16px;">
          <label class="form-label">Status</label>
          <select id="bookingStatus" class="form-select">
            <option value="pending">Pending</option>
            <option value="confirmed">Confirmed</option>
            <option value="completed">Completed</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Notes (optional)</label>
          <textarea id="bookingNotes" class="form-control" rows="3"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="saveStatusChange()">Save</button>
      </div>
    </div>
  </div>
</div>

<script>
  let currentBookingId = null;
  function editBooking(id, status) {
    currentBookingId = id;
    document.getElementById('bookingStatus').value = status;
    document.getElementById('bookingNotes').value = '';
    new bootstrap.Modal(document.getElementById('editBookingModal')).show();
  }

  async function saveStatusChange() {
    const status = document.getElementById('bookingStatus').value;
    const notes = document.getElementById('bookingNotes').value;
    try {
      await fetch('/business/bookings/' + currentBookingId + '/status', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status, notes })
      });
      window.location.reload();
    } catch (err) { console.error('Update error:', err); }
  }
</script>
