<%- layout("layouts/boilerplate.ejs") %>

<div class="premium-page main-content">
  <div class="container">
    <div class="premium-header">
      <h1>Upgrade to Premium</h1>
      <p style="color:var(--text-secondary);font-size:1.05rem;">Unlock powerful features to grow your business and stand out from the crowd.</p>
    </div>

    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="pricing-card featured">
          <div class="pricing-name">Premium</div>
          <div class="pricing-price">₹499</div>
          <div class="pricing-period">per month</div>

          <ul class="pricing-features">
            <li><i class="fa fa-check"></i> Priority Listing in Search</li>
            <li><i class="fa fa-check"></i> Verified Business Badge</li>
            <li><i class="fa fa-check"></i> Analytics Dashboard</li>
            <li><i class="fa fa-check"></i> Priority Customer Support</li>
            <li><i class="fa fa-check"></i> Featured on Homepage</li>
            <li><i class="fa fa-check"></i> Business Hours Display</li>
            <li><i class="fa fa-check"></i> Enhanced Messaging</li>
          </ul>

          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <% if (!currentUser.isPremium || !currentUser.premiumExpiresAt || new Date(currentUser.premiumExpiresAt) <= new Date()) { %>
              <button id="pay-button" data-key="<%= razorpayKeyId %>" class="btn btn-primary btn-lg w-100">
                <i class="fa fa-crown me-2"></i>Get Premium Now
              </button>
            <% } else { %>
              <div style="text-align:center;padding:20px;background:var(--success-subtle);border-radius:var(--radius-lg);border:1px solid rgba(52,211,153,0.2);">
                <i class="fa fa-check-circle" style="font-size:2rem;color:var(--success);margin-bottom:8px;display:block;"></i>
                <strong style="color:var(--success);font-size:1rem;">You are a Premium Member!</strong>
                <p style="color:var(--text-muted);font-size:0.85rem;margin:8px 0 0;">Expires: <%= new Date(currentUser.premiumExpiresAt).toLocaleDateString() %></p>
              </div>
            <% } %>
          <% } else { %>
            <a href="/login" class="btn btn-primary btn-lg w-100">Sign In to Upgrade</a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>if (typeof lucide !== 'undefined') lucide.createIcons();</script>