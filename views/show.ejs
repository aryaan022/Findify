<%- layout('/layouts/boilerplate') %>

<div class="show-page main-content">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="/discover">Discover</a></li>
      <li class="breadcrumb-item active"><%= business.Name %></li>
    </ol>
  </nav>

  <!-- Hero Image -->
  <img src="<%= (business.Image && business.Image.url) ? business.Image.url : 'https://placehold.co/900x400/1e2030/5c5f73?text=No+Image' %>"
    alt="<%= business.Name %>" class="show-hero-img">

  <!-- Header -->
  <div class="show-header">
    <h1><%= business.Name %></h1>
    <div class="show-meta">
      <span class="badge bg-primary"><%= business.Category %></span>
      <% if (business.Owner && business.Owner.premiumExpiresAt && new Date(business.Owner.premiumExpiresAt) > new Date()) { %>
        <span class="premium-badge">⭐ Premium</span>
      <% } %>
      <span><i class="fa fa-map-marker-alt me-1"></i><%= business.address %></span>
      <span><i class="fa fa-star me-1" style="color:var(--warning)"></i><%= business.avgRating || 'N/A' %> (<%= business.reviewCount || 0 %> reviews)</span>
    </div>
  </div>

  <!-- Content Grid -->
  <div class="show-content-grid">
    <!-- Main Content -->
    <div class="show-main">
      <div class="show-card">
        <h3>About</h3>
        <p class="show-description"><%= business.description %></p>
      </div>

      <!-- Reviews Section -->
      <div class="reviews-section">
        <h2>Reviews (<%= business.reviewCount || 0 %>)</h2>

        <% if (business.reviews && business.reviews.length > 0) { %>
          <% business.reviews.forEach(review => { %>
            <div class="review-card">
              <div class="review-header">
                <div class="review-author">
                  <% if (review.author && review.author.username) { %>
                    <%= review.author.username %>
                  <% } else { %>
                    Anonymous
                  <% } %>
                  <% if (review.author && review.author.isPremium) { %>
                    <span class="premium-badge" style="font-size:0.6rem;">PRO</span>
                  <% } %>
                </div>
                <span class="review-date"><%= new Date(review.createdAt).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' }) %></span>
              </div>
              <div class="review-rating">
                <% for (let i = 1; i <= 5; i++) { %>
                  <i class="fa fa-star" style="color: <%= i <= review.rating ? 'var(--warning)' : 'var(--text-muted)' %>; font-size: 0.85rem;"></i>
                <% } %>
              </div>
              <p class="review-text"><%= review.comment %></p>
              <% if (typeof currentUser !== 'undefined' && currentUser && review.author && String(review.author._id) === String(currentUser._id)) { %>
                <div class="review-actions">
                  <a href="/show/<%= business._id %>/reviews/<%= review._id %>/edit" class="action-btn primary"><i class="fa fa-edit me-1"></i>Edit</a>
                </div>
              <% } %>
            </div>
          <% }) %>
        <% } else { %>
          <div class="empty-state" style="padding:40px 20px;">
            <div class="empty-icon"><i class="fa fa-comments"></i></div>
            <h3>No reviews yet</h3>
            <p>Be the first to review this business!</p>
          </div>
        <% } %>

        <!-- Write Review -->
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <div class="review-form">
            <h3>Write a Review</h3>
            <form action="/show/<%= business._id %>/reviews" method="POST">
              <div class="form-group" style="margin-bottom:16px;">
                <label class="form-label">Rating</label>
                <select name="rating" class="form-select" style="max-width:200px;" required>
                  <option value="">Select rating</option>
                  <option value="5">★★★★★ Excellent</option>
                  <option value="4">★★★★☆ Good</option>
                  <option value="3">★★★☆☆ Average</option>
                  <option value="2">★★☆☆☆ Poor</option>
                  <option value="1">★☆☆☆☆ Terrible</option>
                </select>
              </div>
              <div class="form-group" style="margin-bottom:16px;">
                <label class="form-label">Your Review</label>
                <textarea name="comment" class="form-control" rows="4" placeholder="Share your experience..." required></textarea>
              </div>
              <button type="submit" class="btn btn-primary">Submit Review</button>
            </form>
          </div>
        <% } else { %>
          <div class="show-card" style="text-align:center;margin-top:20px;">
            <p style="margin-bottom:12px;"><a href="/login" style="color:var(--accent);font-weight:500;">Sign in</a> to write a review</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="show-sidebar">
      <!-- Contact Info -->
      <div class="show-card">
        <h3>Contact Info</h3>
        <% if (business.Contact) { %>
          <div class="show-detail-row">
            <i class="fa fa-phone"></i>
            <a href="tel:<%= business.Contact %>" style="color:var(--text-secondary);"><%= business.Contact %></a>
          </div>
        <% } %>
        <div class="show-detail-row">
          <i class="fa fa-map-marker-alt"></i>
          <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(business.address) %>" target="_blank" style="color:var(--text-secondary);"><%= business.address %></a>
        </div>
        <% if (business.Owner) { %>
          <div class="show-detail-row">
            <i class="fa fa-user"></i>
            <span>Listed by <%= business.Owner.username %></span>
          </div>
        <% } %>
      </div>

      <!-- Business Hours -->
      <div class="show-card">
        <h3>Business Hours</h3>
        <% let hours = (business && business.hours) ? business.hours : {monday:{open:'09:00',close:'18:00'},tuesday:{open:'09:00',close:'18:00'},wednesday:{open:'09:00',close:'18:00'},thursday:{open:'09:00',close:'18:00'},friday:{open:'09:00',close:'18:00'},saturday:{open:'10:00',close:'16:00'},sunday:{open:'Closed',close:'Closed'}}; %>
        <% const days = ['monday','tuesday','wednesday','thursday','friday','saturday','sunday']; %>
        <% const dayNames = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday']; %>
        <table class="hours-table">
          <% days.forEach((day, i) => { %>
            <tr>
              <td><%= dayNames[i] %></td>
              <td>
                <% if (hours[day] && hours[day].open !== 'Closed') { %>
                  <%= hours[day].open %> - <%= hours[day].close %>
                <% } else { %>
                  <span style="color:var(--error);">Closed</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </table>
      </div>

      <!-- Actions -->
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <div class="show-card">
          <h3>Actions</h3>
          <div class="d-flex flex-column gap-2">
            <% if (currentUser.role === 'user') { %>
              <form action="/favorite/<%= business._id %>" method="POST" style="margin:0;">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="fa fa-heart me-2"></i>Add to Favorites</button>
              </form>
              <a href="/messages/start/<%= business.Owner._id %>?businessId=<%= business._id %>" class="btn btn-ghost w-100"><i class="fa fa-envelope me-2"></i>Message Vendor</a>
            <% } %>
            <% if (currentUser && business.Owner && String(currentUser._id) === String(business.Owner._id)) { %>
              <a href="/edit/<%= business._id %>" class="btn btn-outline-primary w-100"><i class="fa fa-edit me-2"></i>Edit Business</a>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>if (typeof lucide !== 'undefined') lucide.createIcons();</script>
