<%- layout('layouts/boilerplate') %>

<div class="messages-page main-content">
  <div class="container" style="max-width:720px;">
    <div class="d-flex justify-content-between align-items-center" style="margin-bottom:24px;">
      <h1 style="font-size:1.5rem;margin:0;">Messages
        <% if (typeof totalUnread !== 'undefined' && totalUnread > 0) { %>
          <span class="badge bg-primary ms-2"><%= totalUnread %></span>
        <% } %>
      </h1>
    </div>

    <div class="conversation-list">
      <% if (conversations && conversations.length > 0) { %>
        <% conversations.forEach(conv => { %>
          <%
            let otherUser = null;
            if (conv.participants) {
              otherUser = conv.participants.find(p => String(p._id) !== String(currentUser._id));
            }
            const displayName = otherUser ? otherUser.username : 'Unknown User';
            const initial = displayName.charAt(0).toUpperCase();
          %>
          <a href="/messages/<%= conv._id %>" class="conversation-item <%= conv.unreadCount > 0 ? 'unread' : '' %>">
            <div class="conv-avatar"><%= initial %></div>
            <div class="conv-info">
              <div class="conv-name"><%= displayName %></div>
              <div class="conv-preview"><%= conv.lastMessage || 'No messages yet' %></div>
            </div>
            <div class="d-flex flex-column align-items-end gap-1">
              <% if (conv.lastMessageTime) { %>
                <span class="conv-time"><%= new Date(conv.lastMessageTime).toLocaleDateString() %></span>
              <% } %>
              <% if (conv.unreadCount > 0) { %>
                <span class="conv-unread-badge"><%= conv.unreadCount %></span>
              <% } %>
            </div>
          </a>
        <% }) %>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-icon"><i class="fa fa-envelope"></i></div>
          <h3>No conversations</h3>
          <p>Start a conversation by messaging a business owner</p>
          <a href="/discover" class="btn btn-primary">Discover Businesses</a>
        </div>
      <% } %>
    </div>
  </div>
</div>
