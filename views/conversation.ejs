<%- layout('layouts/boilerplate') %>

<div class="chat-page main-content">
  <div class="chat-header-bar">
    <a href="/messages" style="color:var(--text-secondary);margin-right:8px;"><i class="fa fa-arrow-left"></i></a>
    <div class="conv-avatar"><%= otherParticipant.username.charAt(0).toUpperCase() %></div>
    <div style="flex:1;">
      <div style="font-weight:600;font-size:0.95rem;"><%= otherParticipant.username %></div>
      <div style="font-size:0.75rem;color:var(--text-muted);"><%= otherParticipant.role %></div>
    </div>
    <% if (conversation.businessId) { %>
      <span class="badge bg-primary"><%= conversation.businessId.Name %></span>
    <% } %>
    <button class="action-btn danger" style="margin-left:8px;" onclick="blockUser()"><i class="fa fa-ban"></i></button>
  </div>

  <div class="chat-messages" id="chatMessages">
    <% if (messages && messages.length > 0) { %>
      <% messages.forEach(msg => { %>
        <% if (msg.isDeleted) { %>
          <div class="message-bubble received message-deleted" style="font-style:italic;opacity:0.5;">
            <i class="fa fa-ban me-1"></i>Message deleted
          </div>
        <% } else { %>
          <div class="message-bubble <%= String(msg.sender._id) === String(currentUser._id) ? 'sent' : 'received' %>" data-id="<%= msg._id %>">
            <div><%= msg.content %></div>
            <span class="message-time">
              <%= new Date(msg.createdAt).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %>
              <% if (String(msg.sender._id) === String(currentUser._id) && msg.isRead) { %>
                <i class="fa fa-check-double ms-1" style="font-size:0.6rem;"></i>
              <% } %>
            </span>
            <% if (String(msg.sender._id) === String(currentUser._id)) { %>
              <button onclick="deleteMessage('<%= msg._id %>')" style="background:none;border:none;color:rgba(255,255,255,0.4);font-size:0.7rem;cursor:pointer;padding:2px 4px;float:right;"><i class="fa fa-trash"></i></button>
            <% } %>
          </div>
        <% } %>
      <% }) %>
    <% } else { %>
      <div style="text-align:center;padding:60px 20px;color:var(--text-muted);">
        <i class="fa fa-comments" style="font-size:2rem;margin-bottom:12px;opacity:0.4;display:block;"></i>
        <p>Start the conversation</p>
      </div>
    <% } %>
  </div>

  <div class="chat-input-area">
    <form id="msgForm" style="display:flex;gap:10px;width:100%;">
      <input type="text" id="msgInput" class="form-control" placeholder="Type a message..." autocomplete="off" required>
      <button type="submit" class="btn btn-primary"><i class="fa fa-paper-plane"></i></button>
    </form>
  </div>
</div>

<script>
  const conversationId = '<%= conversation._id %>';
  const chatMessages = document.getElementById('chatMessages');

  function scrollToBottom() {
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }
  scrollToBottom();

  // Send message
  document.getElementById('msgForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = document.getElementById('msgInput');
    const content = input.value.trim();
    if (!content) return;

    // Optimistic UI
    const bubble = document.createElement('div');
    bubble.className = 'message-bubble sent';
    bubble.innerHTML = '<div>' + content.replace(/</g,'&lt;') + '</div><span class="message-time">Just now</span>';
    chatMessages.appendChild(bubble);
    scrollToBottom();
    input.value = '';

    try {
      await fetch('/messages/' + conversationId + '/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content })
      });
    } catch (err) { console.error('Send error:', err); }
  });

  // Delete message
  async function deleteMessage(msgId) {
    if (!confirm('Delete this message?')) return;
    try {
      await fetch('/messages/' + conversationId + '/delete/' + msgId, { method: 'DELETE' });
      const el = document.querySelector('[data-id="' + msgId + '"]');
      if (el) { el.innerHTML = '<i class="fa fa-ban me-1"></i>Message deleted'; el.style.opacity = '0.5'; el.style.fontStyle = 'italic'; }
    } catch (err) { console.error('Delete error:', err); }
  }

  // Block user
  async function blockUser() {
    if (!confirm('Block this user? You will no longer receive messages from them.')) return;
    try {
      await fetch('/messages/' + conversationId + '/block', { method: 'PATCH' });
      window.location.href = '/messages';
    } catch (err) { console.error('Block error:', err); }
  }

  // Auto-refresh messages
  setInterval(async () => {
    try {
      const res = await fetch(window.location.href);
      const html = await res.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      const newMessages = doc.getElementById('chatMessages');
      if (newMessages && newMessages.children.length > chatMessages.children.length) {
        chatMessages.innerHTML = newMessages.innerHTML;
        scrollToBottom();
      }
    } catch (err) {}
  }, 3000);
</script>
