<%- layout("layouts/boilerplate.ejs") %>

<% let totalReviewCount = business.reduce((sum, b) => sum + (b.reviewCount || 0), 0); %>
<% let businessesWithRatings = business.filter(b => b.avgRating > 0); %>
<% let overallAvgRating = businessesWithRatings.length > 0 ? (businessesWithRatings.reduce((sum, b) => sum + b.avgRating, 0) / businessesWithRatings.length).toFixed(1) : 'N/A'; %>

<div class="dashboard-page main-content">
  <div class="container">
    <div class="dashboard-header">
      <h1>Welcome back, <%= user.username %></h1>
      <p>
        <% if (user.isPremium && user.premiumExpiresAt && new Date(user.premiumExpiresAt) > new Date()) { %>
          <span class="premium-badge">⭐ Premium</span>
          <span style="color:var(--text-muted);font-size:0.8rem;margin-left:8px;">Expires: <%= new Date(user.premiumExpiresAt).toLocaleDateString() %></span>
        <% } else { %>
          <a href="/premium" style="font-size:0.85rem;">Upgrade to Premium →</a>
        <% } %>
      </p>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon accent"><i class="fa fa-store"></i></div>
        <div class="stat-value"><%= business.length %></div>
        <div class="stat-label">Businesses</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon success"><i class="fa fa-comments"></i></div>
        <div class="stat-value"><%= totalReviewCount %></div>
        <div class="stat-label">Total Reviews</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon warning"><i class="fa fa-star"></i></div>
        <div class="stat-value"><%= overallAvgRating %></div>
        <div class="stat-label">Avg Rating</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon accent"><i class="fa fa-crown"></i></div>
        <div class="stat-value"><%= (user.isPremium && new Date(user.premiumExpiresAt) > new Date()) ? 'Active' : 'Free' %></div>
        <div class="stat-label">Plan</div>
      </div>
    </div>

    <div class="dashboard-section">
      <div class="dashboard-section-title">
        <span>My Businesses</span>
        <a href="/new" class="btn btn-primary btn-sm"><i class="fa fa-plus me-1"></i>Add New</a>
      </div>

      <% if (business.length > 0) { %>
        <div class="row g-4">
          <% business.forEach(bus => { %>
            <div class="col-md-6 col-lg-4">
              <div class="hover-card h-100">
                <div class="business-card-image">
                  <% if (bus.Owner && bus.Owner.premiumExpiresAt && new Date(bus.Owner.premiumExpiresAt) > new Date()) { %>
                    <span class="premium-badge" style="position:absolute;top:10px;left:10px;z-index:2;">⭐ Premium</span>
                  <% } %>
                  <img src="<%= (bus.Image && bus.Image.url) ? bus.Image.url : 'https://placehold.co/400x200/1e2030/5c5f73?text=No+Image' %>"
                    class="card-img-top" alt="<%= bus.Name %>">
                </div>
                <div class="card-body">
                  <h5 class="card-title"><%= bus.Name %></h5>
                  <span class="badge bg-primary mb-2"><%= bus.Category %></span>
                  <div class="d-flex align-items-center gap-2 mb-2">
                    <span style="color:var(--warning);font-size:0.85rem;"><i class="fa fa-star"></i> <%= bus.avgRating || 'N/A' %></span>
                    <span style="color:var(--text-muted);font-size:0.8rem;">(<%= bus.reviewCount || 0 %> reviews)</span>
                  </div>
                  <p class="card-text" style="font-size:0.8rem;"><i class="fa fa-calendar me-1"></i>Listed: <%= new Date(bus.createdAt).toLocaleDateString() %></p>
                  <div class="action-btn-group mt-auto">
                    <a href="/show/<%= bus._id %>" class="action-btn primary">View</a>
                    <a href="/edit/<%= bus._id %>" class="action-btn">Edit</a>
                    <button type="button" class="action-btn danger" onclick="confirmDelete('<%= bus._id %>', '<%= bus.Name %>')">Delete</button>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-icon"><i class="fa fa-store"></i></div>
          <h3>No businesses yet</h3>
          <p>Start by listing your first business</p>
          <a href="/new" class="btn btn-primary">Add Business</a>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Delete Business</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to delete <strong id="businessNameToDelete"></strong>? This action cannot be undone.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <form id="deleteForm" method="POST" style="display:inline;">
          <button type="submit" class="btn btn-danger">Delete</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  function confirmDelete(id, name) {
    document.getElementById('deleteForm').action = '/delete/' + id + '?_method=DELETE';
    document.getElementById('businessNameToDelete').textContent = name;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
  }
  if (typeof lucide !== 'undefined') lucide.createIcons();
</script>