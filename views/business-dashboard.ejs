<%- layout('/layouts/boilerplate') %>

<div class="dashboard-page main-content">
  <div class="container">
    <div class="dashboard-header">
      <h1><%= business.Name %> Dashboard</h1>
      <p><span class="badge bg-primary"><%= business.Category %></span> <span style="color:var(--text-muted);margin-left:8px;"><%= business.City || '' %></span></p>
    </div>

    <div class="stats-grid">
      <div class="stat-card"><div class="stat-icon accent"><i class="fa fa-eye"></i></div><div class="stat-value"><%= analytics.totalViews || 0 %></div><div class="stat-label">Total Views</div></div>
      <div class="stat-card"><div class="stat-icon warning"><i class="fa fa-star"></i></div><div class="stat-value"><%= analytics.avgRating || 'N/A' %></div><div class="stat-label">Avg Rating</div></div>
      <div class="stat-card"><div class="stat-icon success"><i class="fa fa-comments"></i></div><div class="stat-value"><%= analytics.totalReviews || 0 %></div><div class="stat-label">Reviews</div></div>
      <div class="stat-card"><div class="stat-icon accent"><i class="fa fa-calendar"></i></div><div class="stat-value"><%= bookingsThisMonth || 0 %></div><div class="stat-label">Bookings</div></div>
    </div>

    <!-- Quick Actions -->
    <div class="d-flex gap-3 flex-wrap" style="margin-bottom:32px;">
      <a href="/show/<%= business._id %>" class="btn btn-ghost btn-sm"><i class="fa fa-external-link-alt me-2"></i>View Public Page</a>
      <a href="/edit/<%= business._id %>" class="btn btn-ghost btn-sm"><i class="fa fa-edit me-2"></i>Edit Business</a>
      <a href="/business/bookings/<%= business._id %>" class="btn btn-ghost btn-sm"><i class="fa fa-calendar me-2"></i>Manage Bookings</a>
      <a href="/messages" class="btn btn-ghost btn-sm"><i class="fa fa-envelope me-2"></i>Messages <% if (unreadMessages) { %><span class="badge bg-primary ms-1"><%= unreadMessages %></span><% } %></a>
    </div>

    <div class="row g-4">
      <!-- Recent Bookings -->
      <div class="col-lg-7">
        <div class="dashboard-section">
          <div class="dashboard-section-title">Recent Bookings</div>
          <% if (recentBookings && recentBookings.length > 0) { %>
            <% recentBookings.forEach(booking => { %>
              <div class="booking-card">
                <div class="booking-info">
                  <h4><%= booking.customerName %></h4>
                  <p style="color:var(--text-muted)"><%= booking.serviceName %> · <%= new Date(booking.bookingDate).toLocaleDateString() %> at <%= booking.bookingTime %></p>
                </div>
                <span class="booking-status <%= booking.status %>"><%= booking.status %></span>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-state" style="padding:32px 20px;">
              <div class="empty-icon"><i class="fa fa-calendar"></i></div>
              <h3>No recent bookings</h3>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Recent Reviews -->
      <div class="col-lg-5">
        <div class="dashboard-section">
          <div class="dashboard-section-title">Recent Reviews</div>
          <% if (reviews && reviews.length > 0) { %>
            <% reviews.forEach(review => { %>
              <div class="review-card" style="margin-bottom:12px;">
                <div class="review-header">
                  <span class="review-author"><%= review.author ? review.author.username : 'User' %></span>
                </div>
                <div class="review-rating">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <i class="fa fa-star" style="color:<%= i <= review.rating ? 'var(--warning)' : 'var(--text-muted)' %>;font-size:0.75rem;"></i>
                  <% } %>
                </div>
                <p class="review-text" style="font-size:0.85rem;"><%= review.text || review.comment || '' %></p>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-state" style="padding:32px 20px;">
              <div class="empty-icon"><i class="fa fa-star"></i></div>
              <h3>No reviews yet</h3>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Analytics Chart -->
    <div class="dashboard-section" style="margin-top:32px;">
      <div class="dashboard-section-title">Views Analytics</div>
      <div class="analytics-card">
        <canvas id="analyticsChart" height="200"></canvas>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  async function loadAnalyticsData() {
    try {
      const res = await fetch('/business/analytics/<%= business._id %>');
      const data = await res.json();
      renderChart(data);
    } catch (err) { console.error('Analytics error:', err); }
  }

  function renderChart(data) {
    const ctx = document.getElementById('analyticsChart');
    if (!ctx) return;
    const labels = data.viewsByDay ? data.viewsByDay.map(d => d.date) : ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
    const values = data.viewsByDay ? data.viewsByDay.map(d => d.count) : [0,0,0,0,0,0,0];
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{ label: 'Views', data: values, borderColor: '#635bff', backgroundColor: 'rgba(99,91,255,0.1)', fill: true, tension: 0.4 }]
      },
      options: {
        responsive: true,
        plugins: { legend: { labels: { color: '#8b8fa3' } } },
        scales: { x: { ticks: { color: '#5c5f73' }, grid: { color: 'rgba(255,255,255,0.06)' } }, y: { ticks: { color: '#5c5f73' }, grid: { color: 'rgba(255,255,255,0.06)' } } }
      }
    });
  }

  loadAnalyticsData();
  if (typeof lucide !== 'undefined') lucide.createIcons();
</script>
