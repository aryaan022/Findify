<%= layout('/layouts/boilerplate') %>

<section class="form-page">
  <h1><i class="fa fa-store me-2" style="color:var(--accent)"></i>Add New Business</h1>
  <p class="form-subtitle">List your business and start reaching more customers</p>

  <form action="/new" method="POST" enctype="multipart/form-data" id="newBusinessForm">
    <div class="form-card">
      <h2><i class="fa fa-info-circle me-2" style="color:var(--accent)"></i>Basic Information</h2>
      <div class="row g-3">
        <div class="col-md-8">
          <label for="Name" class="form-label">Business Name <span style="color:var(--error)">*</span></label>
          <input type="text" class="form-control" id="Name" name="Name" placeholder="Enter your business name" required>
        </div>
        <div class="col-md-4">
          <label for="Category" class="form-label">Category <span style="color:var(--error)">*</span></label>
          <select class="form-select" id="Category" name="Category" required>
            <option value="">Select category</option>
            <option value="Restaurant">Restaurant</option>
            <option value="Cafe">Cafe / Coffee Shop</option>
            <option value="Retail">Retail Store</option>
            <option value="Books">Bookstore</option>
            <option value="Health">Health & Wellness</option>
            <option value="Beauty">Beauty & Spa</option>
            <option value="Services">Professional Services</option>
            <option value="Automotive">Automotive</option>
            <option value="Entertainment">Entertainment</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="col-12">
          <label for="description" class="form-label">Description <span style="color:var(--error)">*</span></label>
          <textarea class="form-control" id="description" name="description" rows="4" placeholder="Describe your business, what you offer, and what makes you special..." required></textarea>
          <div class="form-text">Minimum 50 characters</div>
        </div>
      </div>
    </div>

    <div class="form-card">
      <h2><i class="fa fa-phone me-2" style="color:var(--accent)"></i>Contact Information</h2>
      <div class="row g-3">
        <div class="col-md-6">
          <label for="Contact" class="form-label">Phone Number <span style="color:var(--error)">*</span></label>
          <input type="tel" class="form-control" id="Contact" name="Contact" placeholder="(555) 123-4567" required>
        </div>
        <div class="col-md-6">
          <label for="email" class="form-label">Email Address</label>
          <input type="email" class="form-control" id="email" name="email" placeholder="business@example.com">
        </div>
      </div>
    </div>

    <div class="form-card">
      <h2><i class="fa fa-map-marker-alt me-2" style="color:var(--accent)"></i>Location & Address</h2>
      <div class="row g-3">
        <div class="col-12">
          <label for="address" class="form-label">Street Address <span style="color:var(--error)">*</span></label>
          <input type="text" class="form-control" id="address" name="address" placeholder="123 Main Street" required>
          <div class="form-text">Enter your full street address</div>
        </div>
        <input type="hidden" id="latitude" name="latitude">
        <input type="hidden" id="longitude" name="longitude">
        <div class="col-12">
          <label class="form-label">Select Location on Map <span style="color:var(--error)">*</span></label>
          <div id="locationMap" class="map-picker" style="height:400px;position:relative;">
            <div style="position:absolute;top:10px;left:10px;background:var(--bg-elevated);padding:8px 14px;border-radius:var(--radius-md);box-shadow:var(--shadow-sm);z-index:10;font-size:0.8rem;color:var(--text-muted);" id="mapInstructions">Click on the map to pin your exact location</div>
          </div>
        </div>
        <div class="col-12">
          <div class="d-none" id="coordinatesDisplay" style="background:var(--accent-subtle);border:1px solid var(--accent-border);border-radius:var(--radius-md);padding:10px 14px;font-size:0.8rem;color:var(--text-secondary);">
            <strong>Selected Coordinates:</strong><br>
            <span id="coordText">Click on the map to select location</span>
          </div>
        </div>
      </div>
    </div>

    <div class="form-card" style="position:relative;">
      <div style="filter:blur(4px);opacity:0.5;pointer-events:none;user-select:none;">
        <h2><i class="fa fa-clock me-2" style="color:var(--accent)"></i>Business Hours</h2>
        <% const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']; %>
        <% days.forEach(day => { %>
        <div class="row align-items-center mb-2">
          <div class="col-md-2"><label class="form-label mb-0"><%= day %></label></div>
          <div class="col-md-3"><input type="time" class="form-control" name="<%= day.toLowerCase() %>_open"></div>
          <div class="col-md-1 text-center"><span style="color:var(--text-muted)">to</span></div>
          <div class="col-md-3"><input type="time" class="form-control" name="<%= day.toLowerCase() %>_close"></div>
          <div class="col-md-3"><div class="form-check"><input class="form-check-input" type="checkbox"><label class="form-check-label">Closed</label></div></div>
        </div>
        <% }); %>
      </div>
      <div style="position:absolute;top:0;left:0;right:0;bottom:0;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:2;color:var(--accent);font-weight:600;">
        <i class="fa fa-lock mb-2" style="font-size:1.5rem;"></i>
        <span>Business Hours feature coming soon!</span>
      </div>
    </div>

    <div class="form-card">
      <h2><i class="fa fa-image me-2" style="color:var(--accent)"></i>Business Image</h2>
      <label for="image" class="form-label">Upload Image <span style="color:var(--error)">*</span></label>
      <input type="file" class="form-control" id="image" name="image" accept="image/*" required>
      <div class="form-text">Upload an image of your business (storefront, logo, etc.)</div>
    </div>

    <div class="form-card">
      <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="agreeTerms" name="agreeTerms" required>
        <label class="form-check-label" for="agreeTerms">
          I agree to the <a href="/terms" target="_blank" style="color:var(--accent)">Terms of Service</a> and
          <a href="/privacy" target="_blank" style="color:var(--accent)">Privacy Policy</a>.
        </label>
      </div>
      <div class="d-flex gap-3 justify-content-end">
        <a href="/dashboard" class="btn btn-outline-light">Cancel</a>
        <button type="submit" class="btn btn-primary btn-lg">Submit for Review</button>
      </div>
    </div>
  </form>
</section>

<script>
    mapboxgl.accessToken = '<%= mapboxToken || "" %>';
    let map, marker = null, selectedCoordinates = null;

    function initializeMap() {
        map = new mapboxgl.Map({
            container: 'locationMap',
            style: 'mapbox://styles/mapbox/dark-v11',
            center: [77.1025, 28.7041],
            zoom: 12
        });
        map.addControl(new mapboxgl.NavigationControl(), 'top-right');
        const geocoder = new MapboxGeocoder({ accessToken: mapboxgl.accessToken, mapboxgl: mapboxgl, placeholder: 'Search for address...', proximity: { lng: 77.1025, lat: 28.7041 } });
        map.addControl(geocoder, 'top-left');
        map.on('click', function(e) { placeMarker(e.lngLat); updateAddressFromCoordinates(e.lngLat); });
        geocoder.on('result', function(e) { const c = e.result.geometry.coordinates; placeMarker({ lng: c[0], lat: c[1] }); updateAddressInput(e.result.place_name); });
    }

    function placeMarker(lngLat) {
        if (marker) marker.remove();
        marker = new mapboxgl.Marker({ color: '#635bff' }).setLngLat([lngLat.lng, lngLat.lat]).addTo(map);
        selectedCoordinates = { lng: lngLat.lng, lat: lngLat.lat };
        document.getElementById('latitude').value = lngLat.lat;
        document.getElementById('longitude').value = lngLat.lng;
        updateCoordinatesDisplay(lngLat.lat, lngLat.lng);
    }

    async function updateAddressFromCoordinates(lngLat) {
        try {
            const r = await fetch(`https://api.mapbox.com/geocoding/v5/mapbox.places/${lngLat.lng},${lngLat.lat}.json?access_token=${mapboxgl.accessToken}`);
            const d = await r.json();
            if (d.features && d.features.length > 0) updateAddressInput(d.features[0].place_name);
        } catch (e) { console.error('Reverse geocoding error:', e); }
    }

    function updateAddressInput(address) { document.getElementById('address').value = address; }

    function updateCoordinatesDisplay(lat, lng) {
        document.getElementById('coordText').textContent = `Latitude: ${lat.toFixed(6)}, Longitude: ${lng.toFixed(6)}`;
        document.getElementById('coordinatesDisplay').classList.remove('d-none');
    }

    document.getElementById('newBusinessForm').addEventListener('submit', function(e) {
        if (document.getElementById('description').value.length < 50) { e.preventDefault(); alert('Description must be at least 50 characters.'); return; }
        if (!document.getElementById('latitude').value || !document.getElementById('longitude').value) { e.preventDefault(); alert('Please select your location on the map.'); return; }
    });

    document.addEventListener('DOMContentLoaded', function() {
        if (!mapboxgl.accessToken) { document.getElementById('locationMap').innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--error)">Map not available. Please configure Mapbox token.</div>'; }
        else { initializeMap(); }
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
</script>

<link href='https://api.mapbox.com/mapbox-gl-js/v3.0.0/mapbox-gl.css' rel='stylesheet' />
<link rel='stylesheet' href='https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v5.0.0/mapbox-gl-geocoder.css' type='text/css' />
<script src='https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v5.0.0/mapbox-gl-geocoder.min.js'></script>