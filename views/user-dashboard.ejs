<%= layout('/layouts/boilerplate', { title: 'User Dashboard - Findify' }) %>

<div class="dashboard-page main-content">
  <div class="container">
    <div class="dashboard-header">
      <h1>Welcome, <%= user.username %></h1>
      <p>
        <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.isPremium && currentUser.premiumExpiresAt && new Date(currentUser.premiumExpiresAt) > new Date()) { %>
          <span class="premium-badge">⭐ Premium Member</span>
        <% } else { %>
          <a href="/premium" style="font-size:0.85rem;">Upgrade to Premium →</a>
        <% } %>
      </p>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon accent"><i class="fa fa-heart"></i></div>
        <div class="stat-value"><%= (favUser && favUser.favorites) ? favUser.favorites.length : 0 %></div>
        <div class="stat-label">Favorites</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon success"><i class="fa fa-pen"></i></div>
        <div class="stat-value"><%= Reviewcount || 0 %></div>
        <div class="stat-label">Reviews</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon warning"><i class="fa fa-crown"></i></div>
        <div class="stat-value"><%= (typeof currentUser !== 'undefined' && currentUser && currentUser.isPremium) ? 'Premium' : 'Free' %></div>
        <div class="stat-label">Account</div>
      </div>
    </div>

    <!-- Favorites -->
    <div class="dashboard-section">
      <div class="dashboard-section-title">
        <span>My Favorites</span>
        <a href="/discover" class="btn btn-ghost btn-sm">Discover More</a>
      </div>

      <% if (favUser && favUser.favorites && favUser.favorites.length > 0) { %>
        <div class="row g-4">
          <% favUser.favorites.forEach(business => { %>
            <div class="col-md-6 col-lg-4">
              <div class="hover-card h-100">
                <div class="business-card-image">
                  <img src="<%= (business.Image && business.Image.url) ? business.Image.url : 'https://placehold.co/400x200/1e2030/5c5f73?text=No+Image' %>"
                    class="card-img-top" alt="<%= business.Name %>">
                </div>
                <div class="card-body">
                  <h5 class="card-title"><%= business.Name %></h5>
                  <span class="badge bg-primary mb-2"><%= business.Category %></span>
                  <div class="d-flex gap-2 mt-auto">
                    <a href="/show/<%= business._id %>" class="btn btn-outline-primary btn-sm flex-fill">View</a>
                    <form action="/favorites/remove/<%= business._id %>" method="POST" style="flex:1;">
                      <button type="submit" class="btn btn-ghost btn-sm w-100"><i class="fa fa-times me-1"></i>Remove</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-icon"><i class="fa fa-heart"></i></div>
          <h3>No favorites yet</h3>
          <p>Start exploring and save businesses you love</p>
          <a href="/discover" class="btn btn-primary">Discover Businesses</a>
        </div>
      <% } %>
    </div>

    <!-- My Reviews -->
    <div class="dashboard-section">
      <div class="dashboard-section-title">My Reviews</div>

      <% if (UserReview && UserReview.length > 0) { %>
        <% UserReview.forEach(review => { %>
          <div class="review-card">
            <div class="review-header">
              <span class="review-author"><%= review.business ? review.business.Name : 'Unknown Business' %></span>
            </div>
            <div class="review-rating">
              <% for (let i = 1; i <= 5; i++) { %>
                <i class="fa fa-star" style="color:<%= i <= review.rating ? 'var(--warning)' : 'var(--text-muted)' %>;font-size:0.85rem;"></i>
              <% } %>
            </div>
            <p class="review-text"><%= review.comment %></p>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-icon"><i class="fa fa-comments"></i></div>
          <h3>No reviews yet</h3>
          <p>Visit businesses and share your experience</p>
        </div>
      <% } %>
    </div>

    <!-- Quick Links -->
    <div class="d-flex gap-3 flex-wrap" style="margin-top:20px;">
      <a href="/premium" class="btn btn-outline-primary"><i class="fa fa-crown me-2"></i>Upgrade</a>
      <a href="/discover" class="btn btn-ghost"><i class="fa fa-compass me-2"></i>Explore</a>
    </div>
  </div>
</div>

<script>if (typeof lucide !== 'undefined') lucide.createIcons();</script>