<%- layout('/layouts/boilerplate') %>

<!-- Hero Section -->
<section class="hero-section">
  <div class="container">
    <h1 class="hero-title">Find & Connect With <span>Local Businesses</span></h1>
    <p class="hero-subtitle">Your trusted guide to the best services, shops, and restaurants right in your neighborhood.</p>

    <div class="search-container">
      <form action="/search" method="GET" class="search-form">
        <div class="search-input-group">
          <span class="search-icon"><i class="fa fa-search"></i></span>
          <input type="text" name="query" placeholder="Search businesses, categories..."
            class="search-input" value="<%= typeof query !== 'undefined' ? query : '' %>" autocomplete="off">
        </div>
        <span class="search-divider"></span>
        <select name="category" class="search-category">
          <option value="">All Categories</option>
          <option value="Restaurant" <%= (typeof category !== 'undefined' && category === 'Restaurant') ? 'selected' : '' %>>Restaurant</option>
          <option value="Services" <%= (typeof category !== 'undefined' && category === 'Services') ? 'selected' : '' %>>Services</option>
          <option value="Dealership" <%= (typeof category !== 'undefined' && category === 'Dealership') ? 'selected' : '' %>>Dealership</option>
          <option value="Cafe" <%= (typeof category !== 'undefined' && category === 'Cafe') ? 'selected' : '' %>>Cafe</option>
          <option value="Shops" <%= (typeof category !== 'undefined' && category === 'Shops') ? 'selected' : '' %>>Shops</option>
          <option value="Retail" <%= (typeof category !== 'undefined' && category === 'Retail') ? 'selected' : '' %>>Retail</option>
          <option value="Books" <%= (typeof category !== 'undefined' && category === 'Books') ? 'selected' : '' %>>Books</option>
          <option value="Automotive" <%= (typeof category !== 'undefined' && category === 'Automotive') ? 'selected' : '' %>>Automotive</option>
          <option value="Entertainment" <%= (typeof category !== 'undefined' && category === 'Entertainment') ? 'selected' : '' %>>Entertainment</option>
          <option value="Health" <%= (typeof category !== 'undefined' && category === 'Health') ? 'selected' : '' %>>Health</option>
          <option value="Beauty" <%= (typeof category !== 'undefined' && category === 'Beauty') ? 'selected' : '' %>>Beauty</option>
          <option value="Other" <%= (typeof category !== 'undefined' && category === 'Other') ? 'selected' : '' %>>Other</option>
        </select>
        <button type="submit" class="search-btn">
          <i class="fa fa-search search-btn-icon"></i> Search
        </button>
      </form>
    </div>
  </div>
</section>

<!-- Search Results -->
<% if (typeof searchResults !== 'undefined' && searchResults !== null) { %>
<section style="padding: 48px 0;">
  <div class="container">
    <div class="section-header" style="text-align: left; margin-bottom: 24px;">
      <% if (business && business.length > 0) { %>
        <h2 class="section-title" style="font-size: 1.5rem;">
          Results for "<%= query %>"
          <% if (category && category !== '') { %> in <%= category %><% } %>
          <span class="badge bg-primary ms-2"><%= business.length %> found</span>
        </h2>
      <% } else { %>
        <h2 class="section-title" style="font-size: 1.5rem;">No Results Found</h2>
      <% } %>
      <% if (query && query.trim() !== '') { %>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Searching for: "<%= query %>"</p>
      <% } %>
    </div>

    <% if (business && business.length > 0) { %>
      <div class="business-grid">
        <% business.forEach(b => { %>
          <div class="hover-card">
            <div class="business-card-image">
              <% if (b.Owner && b.Owner.premiumExpiresAt && new Date(b.Owner.premiumExpiresAt) > new Date()) { %>
                <span class="premium-badge" style="position:absolute;top:10px;left:10px;z-index:2;">⭐ Premium</span>
              <% } %>
              <img src="<%= (b.Image && b.Image.url) ? b.Image.url : 'https://placehold.co/400x200/1e2030/5c5f73?text=No+Image' %>"
                alt="<%= b.Name %>">
            </div>
            <div class="card-body">
              <h5 class="card-title"><%= b.Name %></h5>
              <span class="badge bg-primary mb-2"><%= b.Category %></span>
              <div class="d-flex align-items-center gap-2 mb-3">
                <span class="badge bg-warning"><i class="fa fa-star" style="font-size:0.7rem"></i> <%= b.avgRating %></span>
                <span style="color:var(--text-muted);font-size:0.8rem">(<%= b.reviewCount %> reviews)</span>
              </div>
              <p class="card-text" style="font-size:0.85rem">
                <i class="fa fa-map-marker-alt me-1" style="font-size:0.8rem;color:var(--text-muted)"></i>
                <%= b.address %>
              </p>
              <a href="/show/<%= b._id %>" class="btn btn-outline-primary btn-sm w-100 mt-auto">View Details</a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else if (query && query.trim() !== '') { %>
      <div class="empty-state">
        <div class="empty-icon"><i class="fa fa-search"></i></div>
        <h3>No businesses found</h3>
        <p>Try searching with different keywords or browse all categories</p>
        <a href="/" class="btn btn-primary">Browse All Businesses</a>
      </div>
    <% } %>
  </div>
</section>
<% } %>

<!-- How It Works -->
<section style="padding: 80px 0; border-top: 1px solid var(--border-subtle);">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">How It Works</h2>
      <p class="section-subtitle">Get started in three simple steps</p>
    </div>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="feature-card text-center">
          <div class="feature-card-icon mx-auto"><i class="fa fa-search"></i></div>
          <h5 style="margin-top:16px;font-weight:600;">Search & Discover</h5>
          <p style="font-size:0.9rem;">Find exactly what you need with our powerful search and easy-to-browse categories.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="feature-card text-center">
          <div class="feature-card-icon mx-auto"><i class="fa fa-star"></i></div>
          <h5 style="margin-top:16px;font-weight:600;">View Ratings & Reviews</h5>
          <p style="font-size:0.9rem;">Read authentic reviews from real customers to make informed decisions.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="feature-card text-center">
          <div class="feature-card-icon mx-auto"><i class="fa fa-comments"></i></div>
          <h5 style="margin-top:16px;font-weight:600;">Connect & Visit</h5>
          <p style="font-size:0.9rem;">Get contact details and directions to connect with the best local businesses.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Featured Businesses -->
<section style="padding: 80px 0; background: var(--bg-surface); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Featured Businesses</h2>
      <p class="section-subtitle">Discover the most exciting local businesses near you</p>
    </div>

    <% if (featuredBusinesses && featuredBusinesses.length > 0) { %>
      <div id="featuredCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000" data-bs-pause="hover">
        <div class="carousel-inner">
          <% featuredBusinesses.forEach((b, index) => { %>
            <% if (index % 3 === 0) { %>
              <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                <div class="row g-4 justify-content-center">
            <% } %>
            <div class="col-md-6 col-lg-4">
              <div class="hover-card h-100">
                <div class="business-card-image">
                  <% if (b.Owner && b.Owner.premiumExpiresAt && new Date(b.Owner.premiumExpiresAt) > new Date()) { %>
                    <span class="premium-badge" style="position:absolute;top:10px;left:10px;z-index:2;">⭐ Premium</span>
                  <% } %>
                  <img src="<%= (b.Image && b.Image.url) ? b.Image.url : 'https://placehold.co/400x200/1e2030/5c5f73?text=No+Image' %>"
                    class="card-img-top" alt="<%= b.Name %>">
                </div>
                <div class="card-body">
                  <h5 class="card-title"><%= b.Name %></h5>
                  <span class="badge bg-primary mb-2"><%= b.Category %></span>
                  <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-warning"><i class="fa fa-star" style="font-size:0.7rem"></i> <%= b.avgRating %></span>
                    <span style="color:var(--text-muted);font-size:0.8rem">(<%= b.reviewCount %> reviews)</span>
                  </div>
                  <p class="card-text" style="font-size:0.85rem">
                    <i class="fa fa-map-marker-alt me-1" style="font-size:0.8rem;color:var(--text-muted)"></i>
                    <%= b.address %>
                  </p>
                  <a href="/show/<%= b._id %>" class="btn btn-outline-primary btn-sm w-100 mt-auto">View Details</a>
                </div>
              </div>
            </div>
            <% if ((index + 1) % 3 === 0 || index === featuredBusinesses.length - 1) { %>
                </div>
              </div>
            <% } %>
          <% }) %>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#featuredCarousel" data-bs-slide="prev">
          <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#featuredCarousel" data-bs-slide="next">
          <span class="carousel-control-next-icon"></span>
        </button>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-icon"><i class="fa fa-store"></i></div>
        <h3>No featured businesses yet</h3>
        <p>Check back soon for featured listings</p>
      </div>
    <% } %>
  </div>
</section>

<!-- Top Rated -->
<section style="padding: 80px 0;">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Top Rated by the Community</h2>
      <p class="section-subtitle">The most loved businesses chosen by our users</p>
    </div>

    <div class="row g-4">
      <% if (topRatedBusinesses && topRatedBusinesses.length > 0) { %>
        <% topRatedBusinesses.forEach(b => { %>
          <div class="col-md-6 col-lg-4">
            <div class="hover-card h-100">
              <div class="business-card-image">
                <img src="<%= (b.Image && b.Image.url) ? b.Image.url : 'https://placehold.co/400x200/1e2030/5c5f73?text=No+Image' %>"
                  class="card-img-top" alt="<%= b.Name %>">
              </div>
              <div class="card-body">
                <h5 class="card-title"><%= b.Name %></h5>
                <span class="badge bg-primary mb-2"><%= b.Category %></span>
                <div class="d-flex align-items-center gap-2 mb-3">
                  <span class="badge bg-warning"><i class="fa fa-star" style="font-size:0.7rem"></i> <%= b.avgRating %></span>
                  <span style="color:var(--text-muted);font-size:0.8rem">(<%= b.reviewCount %> reviews)</span>
                </div>
                <p class="card-text" style="font-size:0.85rem">
                  <i class="fa fa-map-marker-alt me-1" style="font-size:0.8rem;color:var(--text-muted)"></i>
                  <%= b.address %>
                </p>
                <a href="/show/<%= b._id %>" class="btn btn-outline-primary btn-sm w-100 mt-auto">View Details</a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12">
          <div class="empty-state">
            <div class="empty-icon"><i class="fa fa-star"></i></div>
            <h3>No top-rated businesses yet</h3>
            <p>Start reviewing businesses to help others discover the best!</p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- Coming Soon -->
<section style="padding: 80px 0; background: var(--bg-surface); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Coming Soon</h2>
      <p class="section-subtitle">We're constantly building new features to make discovering local businesses even better.</p>
    </div>
    <div class="row g-4">
      <div class="col-lg-4">
        <div class="feature-card">
          <div class="feature-card-icon"><i class="fa fa-tag"></i></div>
          <h5 style="font-weight:600;">Real-Time Deals & Offers</h5>
          <p style="font-size:0.9rem;">Get live notifications for happy hour deals, flash sales, and exclusive time-sensitive offers from local businesses.</p>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="feature-card">
          <div class="feature-card-icon"><i class="fa fa-comments"></i></div>
          <h5 style="font-weight:600;">Direct Business Messaging</h5>
          <p style="font-size:0.9rem;">Chat directly and securely with business owners right from their listing page for quick questions.</p>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="feature-card">
          <div class="feature-card-icon"><i class="fa fa-calendar-check"></i></div>
          <h5 style="font-weight:600;">Integrated Booking</h5>
          <p style="font-size:0.9rem;">Book appointments, reservations, and services without ever leaving our site. Seamless and hassle-free.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-section">
  <div class="container">
    <div class="cta-card">
      <h2>Are You a Business Owner?</h2>
      <p>Join our growing community of local businesses and connect with thousands of customers in your area.</p>
      <a href="/new" class="btn btn-primary btn-lg">
        <i class="fa fa-plus-circle me-2"></i>List Your Business Today
      </a>
    </div>
  </div>
</section>

<script>
  if (typeof lucide !== 'undefined') lucide.createIcons();
</script>