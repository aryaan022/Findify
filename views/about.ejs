<%- layout('layouts/boilerplate') %>

<div class="about-page main-content">
  <div class="container">
    <div class="about-hero">
      <h1>About Findify</h1>
      <p style="font-size:1.1rem;max-width:600px;margin:0 auto;">Connecting communities with local businesses since day one. We believe every neighborhood has incredible businesses waiting to be discovered.</p>
    </div>

    <!-- Mission -->
    <div class="row g-4 justify-content-center" style="margin-bottom:60px;">
      <div class="col-lg-8">
        <div class="show-card" style="padding:36px;">
          <h3>Our Mission</h3>
          <p style="font-size:0.95rem;line-height:1.8;">Findify was built with a simple goal: to bridge the gap between local businesses and the communities they serve. We help customers discover amazing services, restaurants, and shops right in their neighborhood, while giving business owners a platform to reach more customers and grow their presence.</p>
        </div>
      </div>
    </div>

    <!-- Features -->
    <div class="section-header">
      <h2 class="section-title">What We Offer</h2>
    </div>
    <div class="row g-4" style="margin-bottom:60px;">
      <div class="col-md-4">
        <div class="feature-card text-center">
          <div class="feature-card-icon mx-auto"><i class="fa fa-search"></i></div>
          <h5 style="margin-top:16px;font-weight:600;">Discover</h5>
          <p style="font-size:0.9rem;">Powerful search and interactive maps to find the best businesses near you.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="feature-card text-center">
          <div class="feature-card-icon mx-auto"><i class="fa fa-star"></i></div>
          <h5 style="margin-top:16px;font-weight:600;">Rate & Review</h5>
          <p style="font-size:0.9rem;">Authentic community reviews to help you make informed decisions.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="feature-card text-center">
          <div class="feature-card-icon mx-auto"><i class="fa fa-comments"></i></div>
          <h5 style="margin-top:16px;font-weight:600;">Connect</h5>
          <p style="font-size:0.9rem;">Message vendors directly and build real connections with local businesses.</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="cta-card" style="margin-top:20px;">
      <h2>Ready to get started?</h2>
      <p>Join Findify today and start exploring or listing your business.</p>
      <div class="d-flex gap-3 justify-content-center flex-wrap">
        <a href="/register" class="btn btn-primary btn-lg">Sign Up Today</a>
        <a href="/discover" class="btn btn-ghost btn-lg">Explore Now</a>
      </div>
    </div>
  </div>
</div>