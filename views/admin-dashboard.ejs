<%- layout('/layouts/boilerplate') %>

<div class="dashboard-page main-content">
  <div class="container">
    <div class="dashboard-header">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <h1>Admin Dashboard</h1>
          <p>System overview and management</p>
        </div>
        <a href="/chatbot/analytics" target="_blank" class="btn btn-ghost btn-sm"><i class="fa fa-chart-bar me-2"></i>Chatbot Analytics</a>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card"><div class="stat-icon accent"><i class="fa fa-users"></i></div><div class="stat-value"><%= stats.totalUsers %></div><div class="stat-label">Total Users</div></div>
      <div class="stat-card"><div class="stat-icon success"><i class="fa fa-user-tie"></i></div><div class="stat-value"><%= stats.activeVendors %></div><div class="stat-label">Vendors</div></div>
      <div class="stat-card"><div class="stat-icon warning"><i class="fa fa-store"></i></div><div class="stat-value"><%= stats.totalBusinesses %></div><div class="stat-label">Businesses</div></div>
      <div class="stat-card"><div class="stat-icon error"><i class="fa fa-clock"></i></div><div class="stat-value"><%= stats.pendingBusinesses %></div><div class="stat-label">Pending</div></div>
      <div class="stat-card"><div class="stat-icon accent"><i class="fa fa-crown"></i></div><div class="stat-value"><%= stats.premiumUsers %></div><div class="stat-label">Premium</div></div>
      <div class="stat-card"><div class="stat-icon success"><i class="fa fa-rupee-sign"></i></div><div class="stat-value">₹<%= stats.totalRevenue ? stats.totalRevenue.toFixed(0) : 0 %></div><div class="stat-label">Revenue</div></div>
    </div>

    <!-- Tabs -->
    <div class="tab-nav">
      <button class="tab-item active" onclick="switchTab('overview')">Overview</button>
      <button class="tab-item" onclick="switchTab('users')">Users</button>
      <button class="tab-item" onclick="switchTab('businesses')">Businesses</button>
    </div>

    <!-- Overview Tab -->
    <div id="tab-overview" class="tab-content">
      <div class="row g-4">
        <div class="col-md-6">
          <div class="show-card">
            <h3>Growth Metrics</h3>
            <div class="d-flex flex-column gap-3">
              <div class="d-flex justify-content-between"><span style="color:var(--text-secondary)">User Growth</span><span style="color:var(--success);font-weight:600"><%= reports.growth.userGrowth %>%</span></div>
              <div class="d-flex justify-content-between"><span style="color:var(--text-secondary)">Business Growth</span><span style="color:var(--success);font-weight:600"><%= reports.growth.businessGrowth %>%</span></div>
              <div class="d-flex justify-content-between"><span style="color:var(--text-secondary)">Review Growth</span><span style="color:var(--success);font-weight:600"><%= reports.growth.reviewGrowth %>%</span></div>
              <div class="d-flex justify-content-between"><span style="color:var(--text-secondary)">Revenue Growth</span><span style="color:var(--success);font-weight:600"><%= reports.growth.revenueGrowth %>%</span></div>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="show-card">
            <h3>Category Distribution</h3>
            <% if (reports.categoryDistribution && reports.categoryDistribution.length > 0) { %>
              <% reports.categoryDistribution.forEach(cat => { %>
                <div class="d-flex justify-content-between align-items-center" style="padding:8px 0;border-bottom:1px solid var(--border-subtle);">
                  <span style="color:var(--text-secondary);font-size:0.9rem;"><%= cat._id %></span>
                  <div class="d-flex align-items-center gap-2">
                    <span style="font-size:0.85rem;font-weight:600;"><%= cat.count %></span>
                    <span style="font-size:0.75rem;color:var(--text-muted);"><%= reports.totalBusinessesForPercentage ? ((cat.count / reports.totalBusinessesForPercentage) * 100).toFixed(1) : 0 %>%</span>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Users Tab -->
    <div id="tab-users" class="tab-content" style="display:none;">
      <div class="table-wrapper">
        <table class="data-table">
          <thead><tr><th>Username</th><th>Email</th><th>Role</th><th>Status</th><th>Joined</th></tr></thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr>
                <td style="font-weight:500;"><%= u.username %></td>
                <td><%= u.email %></td>
                <td><span class="badge bg-<%= u.role === 'admin' ? 'danger' : u.role === 'Vendor' ? 'primary' : 'secondary' %>"><%= u.role %></span></td>
                <td><span class="badge bg-<%= u.status === 'active' ? 'success' : 'warning' %>"><%= u.status || 'active' %></span></td>
                <td style="color:var(--text-muted);font-size:0.8rem;"><%= new Date(u.createdAt).toLocaleDateString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Businesses Tab -->
    <div id="tab-businesses" class="tab-content" style="display:none;">
      <div class="table-wrapper">
        <table class="data-table">
          <thead><tr><th>Name</th><th>Owner</th><th>Category</th><th>Status</th><th>Rating</th><th>Actions</th></tr></thead>
          <tbody>
            <% businesses.forEach(b => { %>
              <tr>
                <td style="font-weight:500;"><%= b.Name %></td>
                <td style="color:var(--text-muted);"><%= b.Owner ? b.Owner.username : 'N/A' %></td>
                <td><span class="badge bg-primary"><%= b.Category %></span></td>
                <td><span class="badge bg-<%= b.status === 'active' ? 'success' : b.status === 'pending' ? 'warning' : 'danger' %>"><%= b.status || 'active' %></span></td>
                <td><i class="fa fa-star" style="color:var(--warning);font-size:0.75rem;"></i> <%= b.avgRating || 'N/A' %></td>
                <td>
                  <div class="action-btn-group">
                    <a href="/show/<%= b._id %>" target="_blank" class="action-btn">View</a>
                    <% if (b.status === 'pending') { %>
                      <form action="/admin/businesses/<%= b._id %>/approve?_method=PATCH" method="POST" style="display:inline;"><button type="submit" class="action-btn success">Approve</button></form>
                      <form action="/admin/businesses/<%= b._id %>/reject?_method=DELETE" method="POST" style="display:inline;" onsubmit="return confirm('Reject this business?')"><button type="submit" class="action-btn danger">Reject</button></form>
                    <% } else if (b.status === 'active') { %>
                      <form action="/admin/businesses/<%= b._id %>/suspend?_method=PATCH" method="POST" style="display:inline;" onsubmit="return confirm('Suspend this business?')"><button type="submit" class="action-btn danger">Suspend</button></form>
                    <% } else if (b.status === 'suspended') { %>
                      <form action="/admin/businesses/<%= b._id %>/reactivate?_method=PATCH" method="POST" style="display:inline;"><button type="submit" class="action-btn success">Reactivate</button></form>
                    <% } %>
                    <form action="/admin/businesses/<%= b._id %>?_method=DELETE" method="POST" style="display:inline;" onsubmit="return confirm('Permanently delete this business?')"><button type="submit" class="action-btn danger">Delete</button></form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  function switchTab(tabName) {
    document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
    document.querySelectorAll('.tab-item').forEach(el => el.classList.remove('active'));
    document.getElementById('tab-' + tabName).style.display = 'block';
    event.target.classList.add('active');
  }
  if (typeof lucide !== 'undefined') lucide.createIcons();
</script>