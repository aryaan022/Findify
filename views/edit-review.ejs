<%- layout('/layouts/boilerplate') %>

<section class="form-page" style="max-width:600px;">
  <h1>Edit Review</h1>
  <p class="form-subtitle">Update your review</p>

  <div class="form-card">
    <form action="/show/<%= businessId %>/reviews/<%= authorId %>/edit" method="POST">
      <div class="form-group" style="margin-bottom:20px;">
        <label class="form-label">Rating</label>
        <div class="d-flex gap-2">
          <% for (let i = 1; i <= 5; i++) { %>
            <label style="cursor:pointer;">
              <input type="radio" name="rating" value="<%= i %>" <%= rating === i ? 'checked' : '' %> style="display:none;" required>
              <i class="fa fa-star" style="font-size:1.5rem;color:<%= i <= rating ? 'var(--warning)' : 'var(--text-muted)' %>;transition:color 0.15s;"></i>
            </label>
          <% } %>
        </div>
      </div>
      <div class="form-group" style="margin-bottom:20px;">
        <label for="comment" class="form-label">Your Review</label>
        <textarea class="form-control" name="comment" id="comment" rows="5" required><%= comment %></textarea>
      </div>
      <div class="d-flex gap-3 justify-content-end">
        <a href="/show/<%= businessId %>" class="btn btn-ghost">Cancel</a>
        <button type="submit" class="btn btn-primary">Update Review</button>
      </div>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll('input[name="rating"]').forEach(radio => {
    radio.addEventListener('change', function() {
      const val = parseInt(this.value);
      document.querySelectorAll('input[name="rating"]').forEach((r, i) => {
        r.nextElementSibling.style.color = (i + 1) <= val ? 'var(--warning)' : 'var(--text-muted)';
      });
    });
  });
</script>