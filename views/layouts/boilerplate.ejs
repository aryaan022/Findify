<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Findify - Local Business Finder</title>
  <meta name="description" content="Discover and support the best local businesses in your area. Find restaurants, shops, services and more." />

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Mapbox -->
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.14.0/mapbox-gl.css" rel="stylesheet">
  <script src="https://api.mapbox.com/mapbox-gl-js/v3.14.0/mapbox-gl.js"></script>

  <!-- Icons -->
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/modern.css" />
  <link rel="stylesheet" href="/css/interactive.css" />
  <link rel="stylesheet" href="/css/index.css" />
  <link rel="stylesheet" href="/css/chatbot.css" />
</head>

<body class="d-flex flex-column min-vh-100">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg fixed-top" id="mainNav">
    <div class="container">
      <a class="navbar-brand" href="/">
        <i data-lucide="map-pin" style="width:20px;height:20px;margin-right:6px;vertical-align:-3px;color:var(--accent)"></i>Findify
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto align-items-lg-center">
          <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/discover">Discover</a></li>
          <li class="nav-item"><a class="nav-link" href="/premium">Premium</a></li>
          <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
          <li class="nav-item"><a class="nav-link" href="/aboutus">About</a></li>
          <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
          <% if (!currentUser) { %>
            <li class="nav-item ms-lg-2">
              <a class="nav-link nav-btn nav-btn-ghost" href="/login">Log in</a>
            </li>
            <li class="nav-item ms-lg-1">
              <a class="nav-link nav-btn nav-btn-primary" href="/register">Sign Up</a>
            </li>
          <% } else { %>
            <li class="nav-item ms-lg-2">
              <a class="nav-link nav-msg-link" href="/messages" id="messagesLink">
                <i class="fa fa-envelope"></i>
                <span class="nav-msg-text">Messages</span>
                <span class="badge bg-danger nav-msg-badge" id="msgBadge" style="display: none;">0</span>
              </a>
            </li>
            <li class="nav-item dropdown ms-lg-2">
              <a class="nav-link dropdown-toggle nav-user-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="nav-avatar">
                  <%= currentUser.username.charAt(0).toUpperCase() %>
                </span>
                <span class="nav-username"><%= currentUser.username %></span>
              </a>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/dashboard"><i data-lucide="layout-dashboard" style="width:16px;height:16px;margin-right:8px"></i>My Dashboard</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/logout"><i data-lucide="log-out" style="width:16px;height:16px;margin-right:8px"></i>Logout</a></li>
              </ul>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Flash Messages -->
  <div class="flash-container">
    <% if(success && success.length){ %>
      <div class="alert alert-success alert-dismissible fade show flash-alert" role="alert">
        <i class="fa fa-check-circle me-2"></i><%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
      </div>
    <% } %>
    <% if(error && error.length){ %>
      <div class="alert alert-danger alert-dismissible fade show flash-alert" role="alert">
        <i class="fa fa-exclamation-circle me-2"></i><%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
      </div>
    <% } %>
  </div>

  <!-- Main Content -->
  <main class="flex-grow-1 main-content"><%- body %></main>

  <!-- Chatbot -->
  <%- include("../chatbot.ejs") %>

  <!-- Footer -->
  <footer class="site-footer mt-auto">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-4 col-md-6">
          <div class="footer-brand">
            <h5><i data-lucide="map-pin" style="width:18px;height:18px;margin-right:6px;vertical-align:-2px"></i>Findify</h5>
            <p>Your guide to discovering and supporting the best local businesses. Connecting communities and helping local economies thrive.</p>
          </div>
        </div>
        <div class="col-lg-2 col-md-3 col-6">
          <h6>Product</h6>
          <ul class="footer-links">
            <li><a href="/">Home</a></li>
            <li><a href="/discover">Discover</a></li>
            <li><a href="/dashboard">Dashboard</a></li>
            <li><a href="/new">List Business</a></li>
          </ul>
        </div>
        <div class="col-lg-2 col-md-3 col-6">
          <h6>Company</h6>
          <ul class="footer-links">
            <li><a href="/aboutus">About</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/terms">Terms</a></li>
            <li><a href="/privacy">Privacy</a></li>
          </ul>
        </div>
        <div class="col-lg-4 col-md-6">
          <h6>Get in Touch</h6>
          <ul class="footer-links footer-contact">
            <li><i data-lucide="map-pin" style="width:14px;height:14px;margin-right:8px"></i>Jalandhar, Punjab, India</li>
            <li><i data-lucide="mail" style="width:14px;height:14px;margin-right:8px"></i>support@Findify.com</li>
            <li><i data-lucide="phone" style="width:14px;height:14px;margin-right:8px"></i>+91 7037169747</li>
          </ul>
        </div>
      </div>

      <hr />

      <div class="footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> Findify. All Rights Reserved.
          <a href="https://github.com/aryaan022/findify" target="_blank" class="footer-github">
            <i class="fab fa-github"></i>
          </a>
        </p>
        <div class="footer-social">
          <a href="https://www.instagram.com/findify.live/" target="_blank" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
          <a href="https://www.linkedin.com/in/aryan022" target="_blank" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script src="/js/interactive.js"></script>

  <!-- Navbar & Message Count -->
  <script>
    // Close mobile menu on link click
    document.querySelectorAll('.navbar-collapse .nav-link, .navbar-collapse .nav-btn').forEach(el => {
      el.addEventListener('click', () => {
        const navbarCollapse = document.querySelector('.navbar-collapse');
        const navbarToggler = document.querySelector('.navbar-toggler');
        if (navbarCollapse.classList.contains('show')) {
          navbarToggler.click();
        }
      });
    });

    // Unread message count
    async function updateUnreadCount() {
      try {
        const response = await fetch('/api/messages/unread-count');
        const data = await response.json();
        const badge = document.getElementById('msgBadge');
        if (data.unreadCount > 0) {
          badge.textContent = data.unreadCount;
          badge.style.display = 'inline-block';
        } else {
          badge.style.display = 'none';
        }
      } catch (err) {
        console.log('Could not fetch unread count');
      }
    }

    <% if (currentUser) { %>
      updateUnreadCount();
      setInterval(updateUnreadCount, 10000);
    <% } %>

    // Auto-dismiss flash messages
    setTimeout(() => {
      document.querySelectorAll('.flash-alert').forEach(alert => {
        alert.classList.remove('show');
        setTimeout(() => alert.remove(), 300);
      });
    }, 5000);
  </script>

  <script src="/js/chatbot.js"></script>
  <script src="/js/premium.js"></script>
</body>
</html>
