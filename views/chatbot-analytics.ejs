<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chatbot Analytics - Findify</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --bg-body: #0f1117; --bg-surface: #161822; --bg-elevated: #1e2030; --bg-hover: #262940;
      --border-subtle: rgba(255,255,255,0.06); --border-default: rgba(255,255,255,0.1);
      --text-primary: #f0f0f5; --text-secondary: #8b8fa3; --text-muted: #5c5f73;
      --accent: #635bff; --accent-subtle: rgba(99,91,255,0.1);
      --success: #34d399; --success-subtle: rgba(52,211,153,0.1);
      --warning: #fbbf24; --warning-subtle: rgba(251,191,36,0.1);
      --error: #f87171; --error-subtle: rgba(248,113,113,0.1);
      --radius-lg: 8px; --radius-xl: 12px;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.3);
    }
    * { box-sizing: border-box; }
    body { font-family: 'Poppins', sans-serif; background: var(--bg-body); color: var(--text-primary); margin: 0; padding: 24px; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; flex-wrap: wrap; gap: 16px; }
    .page-header h1 { font-size: 1.5rem; font-weight: 600; margin: 0; }
    .stat-card { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 20px; }
    .stat-value { font-size: 1.75rem; font-weight: 700; margin-bottom: 4px; }
    .stat-label { font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
    .section-card { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 24px; margin-bottom: 20px; }
    .section-card h3 { font-size: 1rem; font-weight: 600; margin-bottom: 16px; }
    .bar-chart { display: flex; align-items: flex-end; gap: 4px; height: 120px; padding-top: 8px; }
    .bar { background: var(--accent); border-radius: 3px 3px 0 0; min-width: 16px; flex: 1; transition: height 0.3s; position: relative; }
    .bar:hover { background: var(--accent); opacity: 0.8; }
    .bar-label { position: absolute; bottom: -20px; left: 50%; transform: translateX(-50%); font-size: 0.6rem; color: var(--text-muted); white-space: nowrap; }
    .query-item { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-subtle); font-size: 0.85rem; }
    .query-item:last-child { border: none; }
    .btn-refresh { background: var(--bg-elevated); border: 1px solid var(--border-default); color: var(--text-secondary); padding: 8px 16px; border-radius: var(--radius-lg); cursor: pointer; font-family: inherit; font-size: 0.85rem; }
    .btn-refresh:hover { background: var(--bg-hover); color: var(--text-primary); }
    .toggle-auto { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--text-muted); }
    .loading { text-align: center; padding: 60px; color: var(--text-muted); }
  </style>
</head>
<body>
  <div class="container-fluid" style="max-width:1200px;margin:0 auto;">
    <div class="page-header">
      <h1><i class="fa fa-chart-bar me-2" style="color:var(--accent)"></i>Chatbot Analytics</h1>
      <div class="d-flex gap-3 align-items-center">
        <div class="toggle-auto">
          <input type="checkbox" id="autoRefresh"> <label for="autoRefresh">Auto-refresh</label>
        </div>
        <button class="btn-refresh" onclick="fetchAnalytics()"><i class="fa fa-sync me-2"></i>Refresh</button>
        <a href="/" class="btn-refresh" style="text-decoration:none;"><i class="fa fa-home me-1"></i>Home</a>
      </div>
    </div>

    <div id="dashboard-content">
      <div class="loading"><i class="fa fa-spinner fa-spin" style="font-size:2rem;"></i><p style="margin-top:12px;">Loading analytics...</p></div>
    </div>
  </div>

  <script>
    let refreshInterval = null;

    async function fetchAnalytics() {
      try {
        const res = await fetch('/api/chatbot/analytics');
        const data = await res.json();
        renderDashboard(data);
      } catch (err) {
        document.getElementById('dashboard-content').innerHTML = '<div class="loading"><p style="color:var(--error)">Failed to load analytics</p></div>';
      }
    }

    function renderDashboard(data) {
      const o = data.overview || {};
      const rt = data.responseTypes || {};
      const s = data.sentiment || {};
      const pq = data.popularQueries || [];
      const qbh = data.queriesByHour || [];

      let html = `
        <div class="row g-3 mb-4">
          <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-value">${o.totalQueries || 0}</div><div class="stat-label">Total Queries</div></div></div>
          <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-value">${o.uniqueUsers || 0}</div><div class="stat-label">Unique Users</div></div></div>
          <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-value">${o.successRate || 0}%</div><div class="stat-label">Success Rate</div></div></div>
          <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-value">${o.averageResponseTime || 0}ms</div><div class="stat-label">Avg Response</div></div></div>
        </div>
        <div class="row g-3 mb-4">
          <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-value" style="color:var(--accent)">${rt.quickReplies || 0}</div><div class="stat-label">Quick Replies</div></div></div>
          <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-value" style="color:var(--success)">${rt.businessSearches || 0}</div><div class="stat-label">Business Searches</div></div></div>
          <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-value" style="color:var(--warning)">${rt.aiGenerated || 0}</div><div class="stat-label">AI Generated</div></div></div>
          <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-value" style="color:var(--error)">${rt.fallbacks || 0}</div><div class="stat-label">Fallbacks</div></div></div>
        </div>
        <div class="row g-3">
          <div class="col-lg-8">
            <div class="section-card">
              <h3>Queries by Hour</h3>
              <div class="bar-chart" style="margin-bottom:28px;">`;

      if (qbh.length > 0) {
        const maxCount = Math.max(...qbh.map(q => q.count), 1);
        qbh.forEach(q => {
          const height = Math.max((q.count / maxCount) * 100, 4);
          html += `<div class="bar" style="height:${height}%;" title="${q.hour}:00 - ${q.count} queries"><span class="bar-label">${q.hour}</span></div>`;
        });
      } else { html += '<div style="text-align:center;width:100%;color:var(--text-muted);font-size:0.85rem;">No data</div>'; }

      html += `</div></div>
            <div class="section-card">
              <h3>Sentiment Analysis</h3>
              <div class="d-flex gap-4">
                <div><span style="color:var(--success);font-weight:600;font-size:1.25rem;">${s.positive || 0}</span><div style="font-size:0.75rem;color:var(--text-muted);">Positive</div></div>
                <div><span style="color:var(--text-secondary);font-weight:600;font-size:1.25rem;">${s.neutral || 0}</span><div style="font-size:0.75rem;color:var(--text-muted);">Neutral</div></div>
                <div><span style="color:var(--error);font-weight:600;font-size:1.25rem;">${s.negative || 0}</span><div style="font-size:0.75rem;color:var(--text-muted);">Negative</div></div>
              </div>
            </div>
          </div>
          <div class="col-lg-4">
            <div class="section-card">
              <h3>Popular Queries</h3>`;

      if (pq.length > 0) {
        pq.forEach(q => { html += `<div class="query-item"><span style="color:var(--text-secondary)">${q.query}</span><span style="font-weight:600">${q.count}</span></div>`; });
      } else { html += '<p style="color:var(--text-muted);font-size:0.85rem;">No data</p>'; }

      html += `</div></div></div>`;
      document.getElementById('dashboard-content').innerHTML = html;
    }

    document.getElementById('autoRefresh').addEventListener('change', function() {
      if (this.checked) { refreshInterval = setInterval(fetchAnalytics, 3000); }
      else { clearInterval(refreshInterval); }
    });

    fetchAnalytics();
  </script>
</body>
</html>
