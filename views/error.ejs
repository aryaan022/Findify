<%- layout("/layouts/boilerplate") %>

<div class="error-page">
  <div>
    <div class="error-code">404</div>
    <h2>Page Not Found</h2>
    <p style="color:var(--text-secondary);">The page you are looking for might have been moved or doesn't exist.</p>
    <% if (typeof url !== 'undefined' && url) { %>
      <p style="color:var(--text-muted);font-size:0.85rem;">Could not find: <code style="color:var(--accent);"><%= url %></code></p>
    <% } %>
    <div class="error-links">
      <a href="/" class="btn btn-primary">Go Home</a>
      <a href="/discover" class="btn btn-ghost">Discover Businesses</a>
    </div>
  </div>
</div>