<%- layout('/layouts/boilerplate') %>

<div class="discover-page main-content">
  <div class="container">
    <div class="section-header" style="text-align:left;margin-bottom:24px;">
      <h1 class="section-title" style="font-size:1.75rem;">Discover Businesses</h1>
      <p class="section-subtitle" style="margin:0;">Find businesses near you on the map</p>
    </div>

    <!-- Location Controls -->
    <div class="d-flex gap-3 align-items-center flex-wrap" style="margin-bottom:16px;">
      <button id="locateBtn" class="btn btn-primary btn-sm" onclick="getMyLocation()">
        <i class="fa fa-crosshairs me-2"></i>Use My Location
      </button>
      <span id="locationStatus" style="color:var(--text-muted);font-size:0.85rem;">
        <% if (businesses && businesses.length > 0) { %>
          Showing <%= businesses.length %> businesses near you
        <% } else { %>
          Click "Use My Location" to find nearby businesses
        <% } %>
      </span>
    </div>

    <div class="discover-map" id="map" style="height:450px;"></div>

    <% if (businesses && businesses.length > 0) { %>
      <div style="margin-top:32px;">
        <h2 style="font-size:1.25rem;margin-bottom:16px;">Nearby Businesses (<%= businesses.length %>)</h2>
        <div class="business-grid">
          <% businesses.forEach(business => { %>
            <div class="hover-card">
              <div class="business-card-image">
                <img src="<%= (business.Image && business.Image.url) ? business.Image.url : 'https://placehold.co/400x200/1e2030/5c5f73?text=No+Image' %>"
                  class="card-img-top" alt="<%= business.Name %>">
              </div>
              <div class="card-body">
                <h5 class="card-title"><%= business.Name %></h5>
                <span class="badge bg-primary mb-2"><%= business.Category %></span>
                <p class="card-text" style="font-size:0.85rem;"><i class="fa fa-map-marker-alt me-1"></i><%= business.address %></p>
                <a href="/show/<%= business._id %>" class="btn btn-outline-primary btn-sm w-100 mt-auto">View Details</a>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } else { %>
      <div class="empty-state" id="emptyState">
        <div class="empty-icon"><i class="fa fa-compass"></i></div>
        <h3>No nearby businesses found</h3>
        <p>Allow location access or try a different area to find businesses near you</p>
        <button class="btn btn-primary" onclick="getMyLocation()"><i class="fa fa-crosshairs me-2"></i>Find Businesses Near Me</button>
      </div>
    <% } %>
  </div>
</div>

<link href='https://api.mapbox.com/mapbox-gl-js/v3.0.0/mapbox-gl.css' rel='stylesheet' />

<script>
  mapboxgl.accessToken = '<%= mapboxToken %>';
  const map = new mapboxgl.Map({
    container: 'map',
    style: 'mapbox://styles/mapbox/dark-v11',
    center: [77.2090, 28.6139],
    zoom: 10
  });
  map.addControl(new mapboxgl.NavigationControl(), 'top-right');

  // Add business markers from server data
  const businesses = <%- JSON.stringify(businesses) %>;
  businesses.forEach(b => {
    if (b.geometry && b.geometry.coordinates && b.geometry.coordinates.length === 2) {
      const popup = new mapboxgl.Popup({ offset: 25 }).setHTML(
        '<div style="color:#000;padding:4px;">' +
        '<strong>' + b.Name + '</strong><br>' +
        '<span style="font-size:0.8rem;">' + b.Category + '</span><br>' +
        '<a href="/show/' + b._id + '" style="font-size:0.8rem;">View Details</a>' +
        '</div>'
      );
      new mapboxgl.Marker({ color: '#635bff' })
        .setLngLat(b.geometry.coordinates)
        .setPopup(popup)
        .addTo(map);
    }
  });

  // Check if coordinates are in URL (already located)
  const urlParams = new URLSearchParams(window.location.search);
  const lat = urlParams.get('lat');
  const lng = urlParams.get('lng');
  if (lat && lng) {
    // Show user location marker
    new mapboxgl.Marker({ color: '#34d399' })
      .setLngLat([parseFloat(lng), parseFloat(lat)])
      .setPopup(new mapboxgl.Popup().setHTML('<div style="color:#000;padding:4px;"><strong>📍 Your Location</strong></div>'))
      .addTo(map);
    map.flyTo({ center: [parseFloat(lng), parseFloat(lat)], zoom: 12 });
  } else {
    // Auto-detect location on first visit (without URL params)
    autoDetectLocation();
  }

  function getMyLocation() {
    const btn = document.getElementById('locateBtn');
    const status = document.getElementById('locationStatus');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i>Locating...';
    status.textContent = 'Getting your location...';

    if (!navigator.geolocation) {
      btn.disabled = false;
      btn.innerHTML = '<i class="fa fa-crosshairs me-2"></i>Use My Location';
      status.textContent = 'Geolocation is not supported by your browser';
      return;
    }

    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const { latitude, longitude } = pos.coords;
        // Redirect to discover with coordinates — this triggers the backend $near query
        window.location.href = '/discover?lat=' + latitude + '&lng=' + longitude;
      },
      (err) => {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa fa-crosshairs me-2"></i>Use My Location';
        status.textContent = 'Location access denied. Please allow location access and try again.';
        console.error('Geolocation error:', err);
      },
      { enableHighAccuracy: true, timeout: 10000, maximumAge: 300000 }
    );
  }

  function autoDetectLocation() {
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const { latitude, longitude } = pos.coords;
          // Auto-redirect to fetch nearby businesses
          window.location.href = '/discover?lat=' + latitude + '&lng=' + longitude;
        },
        (err) => {
          // Silently fail — user can click the button manually
          console.log('Auto-detect location not available:', err.message);
        },
        { enableHighAccuracy: false, timeout: 5000, maximumAge: 600000 }
      );
    }
  }

  if (typeof lucide !== 'undefined') lucide.createIcons();
</script>
